# ==============================================================================
# CareSync Environment Configuration (.env.example)
# Duplicate this file as .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL via Prisma ORM)
# ------------------------------------------------------------------------------
# Transaction pooler URL (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/caresync_db?schema=public"
# Direct connection URL required for running Prisma migrations
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/caresync_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Server & Networking
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:8500"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate strong, random 32+ character strings (e.g. via `openssl rand -hex 32`)
JWT_ACCESS_SECRET="your-32-character-random-access-token-secret"
JWT_REFRESH_SECRET="your-32-character-random-refresh-token-secret"

# ------------------------------------------------------------------------------
# 4. Background Queue & Redis (BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
# Optional full connection URL (e.g., rediss://default:password@host:port for Upstash)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 5. External Services & Integrations
# ------------------------------------------------------------------------------
# Transactional Email (Resend API) — uses mock fallback when unset or using placeholder
RESEND_API_KEY="re_your_resend_api_key_here"

# Google Generative AI (Gemini 1.5 Flash for Pre-Visit Triage & Post-Visit Summaries)
GEMINI_API_KEY="your-google-gemini-api-key-here"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/callback"

# ------------------------------------------------------------------------------
# 6. Automated Testing Credentials (Playwright E2E)
# ------------------------------------------------------------------------------
TEST_USER_PATIENT_EMAIL="patient@example.com"
TEST_USER_PATIENT_PWD="password"
TEST_USER_DOCTOR_EMAIL="doctor@example.com"
TEST_USER_DOCTOR_PWD="password"
TEST_USER_ADMIN_EMAIL="admin@example.com"
TEST_USER_ADMIN_PWD="password"